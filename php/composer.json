{
  "name": "shipzy/sdk",
  "description": "Official Shipzy logistics platform PHP SDK (early alpha, WIP)",
  "type": "library",
  "license": "MIT",
  "version": "1.1.1",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Shipzy\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shipzy\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit tests"
  },
  "keywords": ["shipzy", "logistics", "sdk", "alpha", "wip"]
}
