{
    "name": "alaikas/zymeup-sdk",
    "description": "Official Zymeup logistics platform SDK for PHP",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Zymeup\\SDK\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Zymeup\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
