{
  "name": "@zymeup/sdk/vue",
  "version": "2.0.0",
  "description": "Vue 3 bindings for Zymeup SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@zymeup/sdk": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --outDir dist",
    "test": "vitest run"
  }
}
