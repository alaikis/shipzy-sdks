{
  "name": "@zymeup/sdk",
  "version": "2.0.1",
  "description": "Official Zymeup logistics platform SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./epod-elements": {
      "import": {
        "types": "./dist/epod-elements/index.d.ts",
        "default": "./dist/epod-elements/index.js"
      },
      "require": {
        "types": "./dist/epod-elements/index.d.cts",
        "default": "./dist/epod-elements/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "shipzy",
    "logistics",
    "sdk",
    "epod",
    "web-components"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "author": ""
}
